{
  "name": "master-server",
  "version": "1.0.0",
  "scripts": {
    "start": "node dist/server.js",
    "test": "npm run typecheck",
    "cluster": "node dist/cluster.js",
    "build": "npm run clean && tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "helmet": "^6.0.0",
    "minimist": "^1.2.8",
    "mongodb": "^6.21.0",
    "mongoose": "^8.16.3",
    "morgan": "^1.10.0",
    "redis": "^5.10.0",
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/mongoose": "^5.11.96",
    "@types/morgan": "^1.9.10",
    "@types/node": "^18.19.111",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.2",
    "typescript": "^4.9.5"
  }
}
